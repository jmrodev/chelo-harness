        else:
            print(f"{CYAN}Instrucciones del Story-Agent:{NC}\n{system_prompt}")

def cmd_agent(role):
    banner()
    check_git_repo()
    roles = {
        "story": "story-agent",
        "spec": "spec-architect",
        "qa": "qa-tester",
        "front": "frontend-dev",
        "back": "backend-dev",
        "git": "git-agent"
    }
    if role not in roles:
        print(f"{RED}❌ Rol de agente desconocido: '{role}'{NC}")
        print(f"{YELLOW}Roles disponibles: story, spec, qa, front, back, git{NC}")
        sys.exit(1)

    agent_id = roles[role]
    prompt_content = get_agent_prompt(agent_id)
    if not prompt_content:
        print(f"{RED}❌ No se encontró la definición del agente '{agent_id}'.{NC}")
        sys.exit(1)

    print(f"{BLUE}🚀 AGENTE CONFINADO:{NC} {BOLD}{agent_id.upper()}{NC}\n")
    runner_opencode = find_opencode_runner()

    if runner_opencode:
        print(f"{GREEN}Ejecutando con OpenCode confinado en sus reglas...{NC}")
        subprocess.run([runner_opencode, "run", prompt_content])
        audit_changes_rule()

        # Feedback Loop para roles de implementación / QA
        if role in ["back", "qa", "front"]:
            if "--control" in sys.argv or "-c" in sys.argv:
                print(f"\n{BOLD}{CYAN}🔍 [MODO CONTROL TOTAL] Revisión de cambios antes de verificar contrato:{NC}")
                subprocess.run(["git", "diff", "--stat"])
                sub_choice = input(f"\n¿Querés ver el diff completo? [s/N]: ").strip().lower()
                if sub_choice == "s":
                    subprocess.run(["git", "diff"])
                aprob = input(f"{BOLD}¿Aprobás continuar a la fase de pruebas? [S/n]: {NC}").strip().lower()
                if aprob == "n":
                    print(f"{YELLOW}Ejecución pausada por el usuario.{NC}")
                    sys.exit(0)

            max_retries = 3
            for attempt in range(1, max_retries + 1):
                print(f"\n{BLUE}▶ Verificando cumplimiento de contrato (Intento {attempt}/{max_retries})...{NC}")
                passed, errors = execute_tests_and_collect_errors()
                if passed:
                    print(f"{GREEN}{BOLD}✓ El agente resolvió la tarea y todos los tests de contrato pasaron.{NC}")
                    break
                else:
                    if attempt == max_retries:
                        print(f"{RED}❌ Límite de auto-correcciones alcanzado. Se requiere intervención manual.{NC}")
                        break

                    error_msg = "\n---\n".join(errors)
                    feedback_prompt = (
                        f"REPORTE DE FALLO DE CONTRATO (SELF-HEALING FEEDBACK):\n\n"
                        f"Los tests Hurl fallaron con los siguientes errores:\n{error_msg}\n\n"
                        f"TU TAREA: Analizá el error exacto y modificá el código para que las aserciones pasen.\n"
                        f"REGLA SAGRADA: NO modifiques el contrato openapi.yaml ni relajes los tests .hurl para que pasen más fácil.\n"
                        f"Preservá el confinamiento (máximo 10 archivos)."
                    )
                    print(f"\n{YELLOW}🔄 Test fallido detectado. Inyectando feedback de error al agente para auto-corrección...{NC}\n")
                    subprocess.run([runner_opencode, "run", feedback_prompt])
                    audit_changes_rule()
    else:
        if shutil.which("wl-copy"):
            subprocess.run(f"printf '%s' \"{prompt_content}\" | wl-copy", shell=True)
            print(f"{GREEN}✓ Prompt del agente copiado al portapapeles.{NC} Pegalo en AGY, Cursor o Claude.")
        else:
            print(prompt_content)

def cmd_gate():
    banner()
    check_git_repo()
    print(f"{BLUE}Iniciando Quality Gate en:{NC} {Path.cwd()}\n")

    if not audit_changes_rule():
        sys.exit(2)

    if not cmd_test():
        sys.exit(1)

    print(f"\n{GREEN}{BOLD}✓ QUALITY GATE SUPERADO EXITOSAMENTE.{NC}")

def cmd_commit(message):
    banner()
    check_git_repo()

    if not audit_changes_rule():
        sys.exit(2)

    if "Co-Authored-By" in message or "AI" in message:
        print(f"{RED}❌ Error de gobernanza: Prohibido incluir atribución de IA o Co-Authored-By en el commit.{NC}")
        sys.exit(1)

    print(f"▶ Commiteando cambios con mensaje convencional: {BOLD}{message}{NC}")
    subprocess.run(["git", "add", "."])
    res = subprocess.run(["git", "commit", "-m", message])
    if res.returncode == 0:
        print(f"{GREEN}✓ Commit exitoso.{NC}")

def cmd_update():
    banner()
    print(f"{BLUE}🔄 ACTUALIZACIÓN DE CHELO-HARNESS{NC}\n")
    print("Actualizando chelo-harness a la última versión...")
    res = subprocess.run("curl -fsSL https://raw.githubusercontent.com/jmrodev/chelo-harness/main/install.sh | bash", shell=True)
    if res.returncode == 0:
        print(f"\n{GREEN}{BOLD}✓ CHELO-HARNESS ACTUALIZADO AL DÍA.{NC}")
    else:
        print(f"\n{RED}❌ Error durante la actualización.{NC}")

def print_help():
    banner()
    print("COMANDOS DISPONIBLES:")
    print("  chelo-harness                   Inicia sesión ágil guiada (Requerimientos -> Contrato -> Agente)")
    print("  chelo-harness init              Inicializa un proyecto nuevo (git, docs/, tests/, openapi.yaml)")
    print("  chelo-harness setup             Asistente universal de claves (Gemini API Key para OpenCode)")
    print("  chelo-harness doctor            Diagnóstico de herramientas (gh, prism, hurl, opencode, keys)")
    print("  chelo-harness update            Actualiza chelo-harness y todas sus herramientas al día")
    print("  chelo-harness sync              Sincronización Daily Scrum (Slack #practicas + Milestones GitHub)")
    print("  chelo-harness board [open|init] Abre el Daily Board o inyecta su GitHub Pages con one-liner")
    print("  chelo-harness story             Inicia entrevista con Story-Agent (Product Owner) para definir BDD")
    print("  chelo-harness agent <rol>       Lanza agente confinado (story, spec, qa, front, back)")
    print("  chelo-harness mock              Levanta Prism Mock Server (:4010) leyendo el openapi.yaml")
    print("  chelo-harness proxy [url]       Levanta Prism Proxy validador contra backend real (:8000)")
    print("  chelo-harness test              Ejecuta la suite de pruebas Hurl (*.hurl) contra el contrato")
    print("  chelo-harness gate              Ejecuta Quality Gate completo (Freno de 10 cambios + Tests Hurl)")
    print("  chelo-harness commit \"<msg>\"    Commitea con validaciones de gobernanza pre-commit")
    print("  chelo-harness status            Inspecciona el estado del workspace bajo las reglas de Chelo")

def main():
    if len(sys.argv) == 1:
        cmd_interactive_session()
        sys.exit(0)

    cmd = sys.argv[1]
    if cmd in ["ask", "learn", "start", "run", "menu"]:
        cmd_interactive_session()
    elif cmd == "init":
        cmd_init()
    elif cmd in ["setup", "config", "keys"]:
        cmd_setup()
    elif cmd in ["doctor", "check"]:
        cmd_doctor()
    elif cmd in ["update", "upgrade"]:
        cmd_update()
    elif cmd in ["sync", "daily", "novedades"]:
        cmd_daily_sync()
    elif cmd in ["story", "historias", "po"]:
        cmd_story()
    elif cmd in ["agent", "agente"]:
        if len(sys.argv) < 3:
            print(f"{RED}Falta el rol. Uso: chelo-harness agent <story|spec|qa|front|back>{NC}")
            sys.exit(1)
        cmd_agent(sys.argv[2])
    elif cmd == "board":
        sub = sys.argv[2] if len(sys.argv) > 2 else "open"
        cmd_board(sub)
    elif cmd == "mock":
        cmd_mock()
    elif cmd == "proxy":
        backend = sys.argv[2] if len(sys.argv) > 2 else f"http://localhost:{BACKEND_PORT}"
        cmd_proxy(backend)
    elif cmd == "test":
        cmd_test()
    elif cmd == "gate":
        cmd_gate()
    elif cmd == "commit":
        if len(sys.argv) < 3:
            print(f"{RED}Falta el mensaje de commit. Uso: chelo-harness commit \"tipo(scope): mensaje\"{NC}")
            sys.exit(1)
        cmd_commit(sys.argv[2])
    elif cmd == "status":
        banner()
        check_git_repo()
        audit_changes_rule()
    else:
        print_help()

def handle_graceful_interrupt(signum, frame):
    """Manejo elegante de Ctrl+C para pausar y ceder el control al orquestador sin trazas de Python."""
    smooth_print(f"\n\n{YELLOW}⏸️  INTERRUPCIÓN DETECTADA (Ctrl+C).{NC}", 0.05)
    smooth_print(f"{CYAN}Pausando agente confinado y preservando el estado del repositorio...{NC}\n", 0.05)
    try:
        audit_changes_rule()
    except Exception:
        pass

    smooth_print(f"\n{BOLD}¿Qué deseás hacer?{NC}", 0.02)
    smooth_print("  [1] 💬 Hablar con el Lead-Architect para reorientar el plan", 0.02)
    smooth_print("  [2] 🔍 Ver git diff de lo avanzado hasta ahora", 0.02)
    smooth_print("  [3] ↩️  Descartar cambios de esta iteración (git restore)", 0.02)
    smooth_print("  [4] 🚪 Salir definitivamente", 0.02)

    try:
        op = input(f"\n{BOLD}Seleccioná [1-4] (Default: 1): {NC}").strip()
        if op == "2":
            subprocess.run(["git", "diff"])
        elif op == "3":
            subprocess.run(["git", "restore", "."])
            smooth_print(f"{GREEN}✓ Workspace restablecido.{NC}")
        elif op == "4":
            smooth_print(f"{YELLOW}Sesión finalizada por el usuario.{NC}")
            sys.exit(0)

        cmd_interactive_session()
    except (KeyboardInterrupt, EOFError):
        smooth_print(f"\n{YELLOW}Sesión interrumpida. Hasta luego.{NC}")
        sys.exit(0)
    except Exception:
        sys.exit(0)

if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGINT, handle_graceful_interrupt)
    main()
