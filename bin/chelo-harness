def get_agent_prompt(agent_name):
    """Obtiene el prompt de un agente especializado desde local o fallback empaquetado."""
    candidates = [
        Path.cwd() / "agents" / f"{agent_name}.md",
        Path.home() / ".local/share/chelo/agents" / f"{agent_name}.md",
        Path(__file__).resolve().parent.parent / "agents" / f"{agent_name}.md"
    ]
    for c in candidates:
        if c.is_file():
            return c.read_text(encoding="utf-8")
    return None

