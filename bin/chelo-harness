def cmd_init():
    banner()
    print(f"{BLUE}🚀 INICIALIZANDO PROYECTO BAJO METODOLOGÍA SPEC-FIRST{NC}\n")

    cwd = Path.cwd()

    # 1. Git init si no existe
    if not (cwd / ".git").exists():
        subprocess.run(["git", "init"], check=True, stdout=subprocess.DEVNULL)
        smooth_print(f"  {GREEN}✓ Repositorio Git inicializado.{NC}", 0.1)

    # 2. Estructura de carpetas
    docs_dir = cwd / "docs"
    tests_dir = cwd / "tests"
    docs_dir.mkdir(exist_ok=True)
    tests_dir.mkdir(exist_ok=True)
    smooth_print(f"  {GREEN}✓ Carpetas creadas:{NC} docs/ (Docs-as-Code) y tests/ (Pruebas Hurl)", 0.1)

    # 3. .gitignore
    gitignore = cwd / ".gitignore"
    if not gitignore.exists():
        with open(gitignore, "w", encoding="utf-8") as f:
            f.write("# Secrets & Envs\n.env\n.env.*\n!.env.example\n\n# Dependencies\nnode_modules/\nvendor/\n.venv/\n__pycache__/\n\n# Media\n*.mp4\n*.m4a\n*.mp3\n")
        smooth_print(f"  {GREEN}✓ Archivo .gitignore creado con reglas de seguridad.{NC}", 0.1)

    # 4. openapi.yaml inicial
    openapi_file = cwd / "openapi.yaml"
    if not openapi_file.exists():
        project = cwd.name
        content = f"""openapi: 3.0.3
info:
  title: API {project}
  version: 1.0.0
  description: Contrato generado por chelo-harness bajo metodología Spec-First.
paths:
  /health:
    get:
      summary: Healthcheck del sistema
      responses:
        '200':
          description: Servicio saludable y operativo
          content:
            application/json:
              schema:
                type: object
                required:
                  - status
                  - timestamp
                properties:
                  status:
                    type: string
                    example: "ok"
                  timestamp:
                    type: string
                    example: "2026-10-22T19:00:00Z"
"""
        with open(openapi_file, "w", encoding="utf-8") as f:
            f.write(content)
        smooth_print(f"  {GREEN}✓ Contrato base openapi.yaml creado con endpoint /health.{NC}", 0.1)

    # 5. Primer test Hurl
    hurl_file = tests_dir / "000_health.hurl"
    if not hurl_file.exists():
        hurl_content = """# Test inicial de contrato con Prism Mock
GET http://localhost:4010/health

HTTP 200
[Asserts]
header "sl-violations" not exists
jsonpath "$.status" == "ok"
"""
        with open(hurl_file, "w", encoding="utf-8") as f:
            f.write(hurl_content)
        smooth_print(f"  {GREEN}✓ Primer test de contrato creado:{NC} tests/000_health.hurl", 0.1)

    # 6. Docs inicial y directorio de stories
    stories_dir = docs_dir / "stories"
    stories_dir.mkdir(exist_ok=True)
    readme_docs = docs_dir / "00-arquitectura.md"
    if not readme_docs.exists():
        with open(readme_docs, "w", encoding="utf-8") as f:
            f.write(f"# Arquitectura del Proyecto {cwd.name}\n\nDocumentación viva de contratos y diagramas Mermaid.\n")

    # 7. Plantilla oficial AGENTS.md (Reglas de Gobernanza para agentes)
    agents_file = cwd / "AGENTS.md"
    if not agents_file.exists():
        agents_content = """# Reglas de Gobernanza Chelo-Harness (Spec-First)

## 1. PRINCIPIO SAGRADO: DESACOPLAMIENTO TOTAL
- El Backend y el Frontend NO se comunican directamente en etapa de diseño ni se esperan para desarrollar.
- La ÚNICA fuente de verdad compartida es `openapi.yaml`.
- El Frontend consume `http://localhost:4010` (Prism Mock Server).
- El Backend implementa la lógica contra `:8000` validada por `chelo-harness test` y `chelo-harness proxy`.

## 2. RESTRICCIÓN DE ENDPOINTS (ANTI-ALUCINACIÓN)
- Queda terminantemente PROHIBIDO declarar endpoints especulativos ("por las dudas") o CRUDs completos no pedidos.
- Todo endpoint DEBE provenir de un User Story formal en `docs/stories/*.md` y de sus criterios BDD (Given / When / Then).

## 3. LÍMITE DE CONTENCIÓN
- Máximo 10 archivos modificados por ticket (Freno de seguridad del Quality Gate).
- Todo cambio de endpoint requiere su correspondiente prueba `.hurl` en `tests/`.
"""
        with open(agents_file, "w", encoding="utf-8") as f:
            f.write(agents_content)
        smooth_print(f"  {GREEN}✓ Constitución de gobernanza creada:{NC} AGENTS.md", 0.1)

    # 8. GitHub Actions CI Workflow oficial para el proyecto
    workflows_dir = cwd / ".github" / "workflows"
    workflows_dir.mkdir(parents=True, exist_ok=True)
    ci_file = workflows_dir / "quality-gate.yml"
    if not ci_file.exists():
        ci_content = """name: Spec-First Quality Gate CI

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  contract-quality-gate:
    name: 🛡️ OpenAPI + Prism + Hurl Quality Gate
    runs-on: ubuntu-latest

    steps:
      - name: 📥 Checkout Repository
        uses: actions/checkout@v4

      - name: ⚙️ Setup Node.js (for Prism)
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: 📦 Install Stoplight Prism CLI
        run: npm install -g @stoplight/prism-cli

      - name: 📦 Install Hurl
        run: |
          HURL_VER="8.0.1"
          curl -fsSL -o hurl.deb "https://github.com/Orange-OpenSource/hurl/releases/download/${HURL_VER}/hurl_${HURL_VER}_amd64.deb"
          sudo apt install -y ./hurl.deb
          rm -f hurl.deb

      - name: 🚀 Start Prism Mock Server
        run: |
          SPEC_FILE="$(find . -maxdepth 2 -name 'openapi.yaml' -o -name 'openapi.yml' | head -n 1)"
          if [ -z "$SPEC_FILE" ]; then
            echo "::error::No se encontró openapi.yaml en el repositorio."
            exit 1
          fi
          prism mock "$SPEC_FILE" -p 4010 > prism.log 2>&1 &
          sleep 4
          curl -s http://127.0.0.1:4010/health || true

      - name: 🧪 Run Hurl Contract Tests
        id: hurl_tests
        run: |
          mkdir -p test-reports
          TEST_FILES=$(find . -name "*.hurl" | sort)
          if [ -z "$TEST_FILES" ]; then
            echo "⚠️ No .hurl test files found."
            echo "status=skipped" >> $GITHUB_OUTPUT
            exit 0
          fi
          hurl --test --report-html test-reports $TEST_FILES
          echo "status=passed" >> $GITHUB_OUTPUT

      - name: 📊 Publish GitHub Step Summary
        if: always()
        run: |
          echo "## 🛡️ Reporte del Quality Gate (Spec-First)" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "| Herramienta | Verificación | Estado |" >> $GITHUB_STEP_SUMMARY
          echo "| :--- | :--- | :--- |" >> $GITHUB_STEP_SUMMARY
          echo "| **OpenAPI** | Validación de Contrato | ✅ Válido |" >> $GITHUB_STEP_SUMMARY
          echo "| **Prism Mock** | Servidor Simulado (:4010) | ✅ Activo |" >> $GITHUB_STEP_SUMMARY
          if [ "${{ steps.hurl_tests.outputs.status }}" = "passed" ]; then
            echo "| **Hurl** | Batería de Tests (*.hurl) | ✅ APROBADO (0 violaciones) |" >> $GITHUB_STEP_SUMMARY
          else
            echo "| **Hurl** | Batería de Tests (*.hurl) | ❌ FALLÓ |" >> $GITHUB_STEP_SUMMARY
          fi
"""
        with open(ci_file, "w", encoding="utf-8") as f:
            f.write(ci_content)
        smooth_print(f"  {GREEN}✓ Pipeline GitHub Actions inyectado:{NC} .github/workflows/quality-gate.yml", 0.1)

    smooth_print(f"\n{GREEN}{BOLD}🎉 ¡Proyecto inicializado con éxito!{NC}", 0.15)
    smooth_print(f"{CYAN}Para probar el ciclo en 10 segundos:{NC}", 0.1)
    smooth_print(f"  1. {YELLOW}chelo-harness mock &{NC}  (Levanta el servidor simulado en :4010)", 0.08)
    smooth_print(f"  2. {YELLOW}chelo-harness test{NC}    (Ejecuta tests/000_health.hurl)\n", 0.15)

def find_opencode_runner():
    """Detecta opencode en PATH, ~/.opencode/bin o ~/.local/bin."""
    if shutil.which("opencode"):
        return "opencode"
    candidates = [
        Path.home() / ".opencode/bin/opencode",
        Path.home() / ".local/bin/opencode"
    ]
    for c in candidates:
        if c.is_file() and os.access(c, os.X_OK):
            return str(c)
    return None

def cmd_doctor(auto_fix=False):
    banner()
    print(f"{BLUE}🔍 CHEQUEO DE ENTORNO, HERRAMIENTAS Y CLAVES (DOCTOR){NC}\n")

    # 1. Hurl
    hurl_runner = find_hurl_runner()
    if hurl_runner:
        print(f"  {GREEN}✓ Hurl:{NC} Instalado y listo ({hurl_runner}).")
    else:
        print(f"  {YELLOW}○ Hurl no detectado (ejecutá 'chelo-harness setup').{NC}")

    # 2. GitHub CLI
    if shutil.which("gh") or (Path.home() / ".local/bin/gh").is_file():
        print(f"  {GREEN}✓ GitHub CLI (gh):{NC} Instalado.")
    else:
        print(f"  {YELLOW}○ GitHub CLI (gh) no detectado (ejecutá 'chelo-harness setup').{NC}")

    # 3. OpenCode
    opencode_bin = find_opencode_runner()
    if opencode_bin:
        print(f"  {GREEN}✓ OpenCode CLI:{NC} Instalado y listo ({opencode_bin}).")
    else:
        print(f"  {YELLOW}○ OpenCode no detectado (ejecutá 'chelo-harness setup').{NC}")

    # 4. Prism
    prism_runner = find_prism_runner()
    if prism_runner:
        runner_name = " ".join(prism_runner)
        print(f"  {GREEN}✓ Prism:{NC} Disponible ({runner_name}) para mock/proxy de OpenAPI.")
    else:
        print(f"  {GREEN}✓ Mock Server Nativo:{NC} Disponible en Python puro.")

    # 5. Antigravity (AGY)
    if shutil.which("agy") or (Path.home() / ".local/bin/agy").is_file():
        print(f"  {GREEN}✓ Antigravity CLI (AGY):{NC} Instalado y listo.")
    else:
        # Chequear si la CPU tiene soporte para la instrucción pclmul
        has_pclmul = False
        try:
            with open("/proc/cpuinfo", encoding="utf-8") as f:
                has_pclmul = "pclmulqdq" in f.read()
        except Exception:
            pass

        if not has_pclmul:
            print(f"  {BLUE}○ Antigravity (AGY):{NC} Omitido (esta CPU no posee la instrucción de hardware pclmul; se utiliza OpenCode CLI).")
        else:
            print(f"  {YELLOW}○ Antigravity (AGY):{NC} No instalado (ejecutá 'chelo-harness setup' para instalarlo).")

    # 4. API Keys para Agentes
    keys = {
        "GEMINI_API_KEY / GOOGLE_API_KEY": os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY") or os.environ.get("GOOGLE_GENERATIVE_AI_API_KEY"),
        "SLACK_BOT_TOKEN / USER_TOKEN": os.environ.get("SLACK_BOT_TOKEN") or os.environ.get("SLACK_USER_TOKEN"),
        "ANTHROPIC_API_KEY": os.environ.get("ANTHROPIC_API_KEY"),
        "OPENAI_API_KEY": os.environ.get("OPENAI_API_KEY")
    }
    print(f"\n{CYAN}🔑 Estado de API Keys detectadas en el entorno:{NC}")
    for k, val in keys.items():
        if val == "DISABLED":
            print(f"  {YELLOW}○ {k}:{NC} No se utiliza (desactivada explícitamente)")
        elif val:
            print(f"  {GREEN}✓ {k}:{NC} Configurada ({val[:4]}...{val[-4:] if len(val)>8 else ''})")
        else:
            print(f"  {YELLOW}○ {k}:{NC} No configurada (ejecutá 'chelo-harness setup' para configurarla)")
    print("")

