MAX_ALLOWED_CHANGES = 10
PRISM_PORT = 4010
BACKEND_PORT = 8000

def banner():
    print(f"{CYAN}{BOLD}╔═══════════════════════════════════════════════════════════════════╗{NC}")
    print(f"{CYAN}{BOLD}║         🛡️  CHELO-HARNESS — AGILE & CONTRACT RUNTIME               ║{NC}")
