def cmd_init():
    banner()
    print(f"{BLUE}🚀 INICIALIZANDO PROYECTO BAJO METODOLOGÍA SPEC-FIRST{NC}\n")

    cwd = Path.cwd()

    # 1. Git init si no existe
    if not (cwd / ".git").exists():
        subprocess.run(["git", "init"], check=True)
        print(f"  {GREEN}✓ Repositorio Git inicializado.{NC}")

    # 2. Estructura de carpetas
    docs_dir = cwd / "docs"
    tests_dir = cwd / "tests"
    docs_dir.mkdir(exist_ok=True)
    tests_dir.mkdir(exist_ok=True)
    print(f"  {GREEN}✓ Carpetas creadas:{NC} docs/ (Docs-as-Code) y tests/ (Pruebas Hurl)")

    # 3. .gitignore
    gitignore = cwd / ".gitignore"
    if not gitignore.exists():
        with open(gitignore, "w", encoding="utf-8") as f:
            f.write("# Secrets & Envs\n.env\n.env.*\n!.env.example\n\n# Dependencies\nnode_modules/\nvendor/\n.venv/\n__pycache__/\n\n# Media\n*.mp4\n*.m4a\n*.mp3\n")
        print(f"  {GREEN}✓ Archivo .gitignore creado con reglas de seguridad.{NC}")

    # 4. openapi.yaml inicial
    openapi_file = cwd / "openapi.yaml"
    if not openapi_file.exists():
        project = cwd.name
        content = f"""openapi: 3.0.3
info:
  title: API {project}
  version: 1.0.0
  description: Contrato generado por chelo-harness bajo metodología Spec-First.
paths:
  /health:
    get:
      summary: Healthcheck del sistema
      responses:
        '200':
          description: Servicio saludable y operativo
          content:
            application/json:
              schema:
                type: object
                required:
                  - status
                  - timestamp
                properties:
                  status:
                    type: string
                    example: "ok"
                  timestamp:
                    type: string
                    example: "2026-10-22T19:00:00Z"
"""
        with open(openapi_file, "w", encoding="utf-8") as f:
            f.write(content)
        print(f"  {GREEN}✓ Contrato base openapi.yaml creado con endpoint /health.{NC}")

    # 5. Primer test Hurl
    hurl_file = tests_dir / "000_health.hurl"
    if not hurl_file.exists():
        hurl_content = """# Test inicial de contrato con Prism Mock
GET http://localhost:4010/health

HTTP 200
[Asserts]
header "sl-violations" not exists
jsonpath "$.status" == "ok"
"""
        with open(hurl_file, "w", encoding="utf-8") as f:
            f.write(hurl_content)
        print(f"  {GREEN}✓ Primer test de contrato creado:{NC} tests/000_health.hurl")

    # 6. Docs inicial
    readme_docs = docs_dir / "00-arquitectura.md"
    if not readme_docs.exists():
        with open(readme_docs, "w", encoding="utf-8") as f:
            f.write(f"# Arquitectura del Proyecto {cwd.name}\n\nDocumentación viva de contratos y diagramas Mermaid.\n")

    print(f"\n{GREEN}{BOLD}🎉 ¡Proyecto inicializado con éxito!{NC}")
    print(f"{CYAN}Para probar el ciclo en 10 segundos:{NC}")
    print(f"  1. {YELLOW}chelo-harness mock &{NC}  (Levanta el servidor simulado en :4010)")
    print(f"  2. {YELLOW}chelo-harness test{NC}    (Ejecuta tests/000_health.hurl)")
    print("")

def find_opencode_runner():
    """Detecta opencode en PATH, ~/.opencode/bin o ~/.local/bin."""
    if shutil.which("opencode"):
        return "opencode"
    candidates = [
        Path.home() / ".opencode/bin/opencode",
        Path.home() / ".local/bin/opencode"
    ]
    for c in candidates:
        if c.is_file() and os.access(c, os.X_OK):
            return str(c)
    return None

def cmd_doctor(auto_fix=False):
    banner()
    print(f"{BLUE}🔍 CHEQUEO DE ENTORNO, HERRAMIENTAS Y CLAVES (DOCTOR){NC}\n")

    # 1. Hurl
    hurl_runner = find_hurl_runner()
    if hurl_runner:
        print(f"  {GREEN}✓ Hurl:{NC} Instalado y listo ({hurl_runner}).")
    else:
        print(f"  {YELLOW}○ Hurl no detectado (ejecutá 'chelo-harness setup').{NC}")

    # 2. GitHub CLI
    if shutil.which("gh") or (Path.home() / ".local/bin/gh").is_file():
        print(f"  {GREEN}✓ GitHub CLI (gh):{NC} Instalado.")
    else:
        print(f"  {YELLOW}○ GitHub CLI (gh) no detectado (ejecutá 'chelo-harness setup').{NC}")

    # 3. OpenCode
    opencode_bin = find_opencode_runner()
    if opencode_bin:
        print(f"  {GREEN}✓ OpenCode CLI:{NC} Instalado y listo ({opencode_bin}).")
    else:
        print(f"  {YELLOW}○ OpenCode no detectado (ejecutá 'chelo-harness setup').{NC}")

    # 4. Prism
    prism_runner = find_prism_runner()
    if prism_runner:
        runner_name = " ".join(prism_runner)
        print(f"  {GREEN}✓ Prism:{NC} Disponible ({runner_name}) para mock/proxy de OpenAPI.")
    else:
        print(f"  {GREEN}✓ Mock Server Nativo:{NC} Disponible en Python puro.")

    if shutil.which("agy") or (Path.home() / ".local/bin/agy").is_file():
        print(f"  {GREEN}✓ Antigravity CLI (AGY):{NC} Instalado.")
    else:
        print(f"  {BLUE}○ Antigravity (AGY):{NC} No requerido en servidores remotos (se utiliza OpenCode CLI).")

    # 4. API Keys para Agentes
    keys = {
        "GEMINI_API_KEY / GOOGLE_API_KEY": os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY") or os.environ.get("GOOGLE_GENERATIVE_AI_API_KEY"),
        "SLACK_BOT_TOKEN / USER_TOKEN": os.environ.get("SLACK_BOT_TOKEN") or os.environ.get("SLACK_USER_TOKEN"),
        "ANTHROPIC_API_KEY": os.environ.get("ANTHROPIC_API_KEY"),
        "OPENAI_API_KEY": os.environ.get("OPENAI_API_KEY")
    }
    print(f"\n{CYAN}🔑 Estado de API Keys detectadas en el entorno:{NC}")
    for k, val in keys.items():
        if val == "DISABLED":
            print(f"  {YELLOW}○ {k}:{NC} No se utiliza (desactivada explícitamente)")
        elif val:
            print(f"  {GREEN}✓ {k}:{NC} Configurada ({val[:4]}...{val[-4:] if len(val)>8 else ''})")
        else:
            print(f"  {YELLOW}○ {k}:{NC} No configurada (ejecutá 'chelo-harness setup' para configurarla)")
    print("")

def cmd_daily_sync():
    banner()
    print(f"{BLUE}☕ SINCRONIZACIÓN DAILY SCRUM & CANALES DEL EQUIPO{NC}\n")

    print(f"{CYAN}📡 Consultando canal #practicas de Slack...{NC}")
    res = chelo_channels.get_slack_messages(limit=3)
    if res.get("ok"):
        for m in res.get("messages", []):
            print(f"   💬 {YELLOW}{m.get('user')}{NC}: {m.get('text')[:120]}...")
    else:
        print(f"   {YELLOW}⚠️  Slack no disponible o sin token: {res.get('error')}{NC}")

    print(f"\n{CYAN}📌 Consultando Sprint y Milestones de GitHub...{NC}")
    if shutil.which("gh"):
        sprint_info = chelo_channels.get_github_sprint_context()
        m = sprint_info.get("milestone")
        if m:
            print(f"   🏆 {GREEN}Milestone Activo:{NC} {BOLD}{m.get('title')}{NC} (Vence: {m.get('due_on', 'N/A')})")
            print(f"      Progreso: {m.get('closed_issues')} cerrados / {m.get('open_issues')} abiertos")
        else:
            print(f"   {YELLOW}No hay Milestones abiertos en este repositorio.{NC}")
    print("")

def cmd_board(action="open"):
    banner()
    if action == "init":
        print(f"{BLUE}🚀 Instalando Daily Board en este repositorio...{NC}")
        subprocess.run("curl -sL https://raw.githubusercontent.com/jmrodev/daily-board/main/install.sh | bash", shell=True)
    else:
        try:
            repo_url = subprocess.run(["gh", "repo", "view", "--json", "url", "-q", ".url"], capture_output=True, text=True).stdout.strip()
            if repo_url:
                org_repo = repo_url.replace("https://github.com/", "")
                org, repo = org_repo.split("/")
                board_url = f"https://{org}.github.io/{repo}/"
                print(f"{GREEN}✓ Abriendo Daily Board:{NC} {board_url}")
                subprocess.run(["xdg-open", board_url], capture_output=True)
            else:
                subprocess.run(["xdg-open", "https://jmrodev.github.io/daily-board/"], capture_output=True)
        except Exception:
            print(f"{YELLOW}No se pudo detectar URL de GitHub Pages. Abriendo repo de Daily Board...{NC}")
            subprocess.run(["xdg-open", "https://github.com/jmrodev/daily-board"], capture_output=True)

def find_openapi_spec():
    candidates = list(Path.cwd().glob("**/openapi.yaml")) + \
                 list(Path.cwd().glob("**/openapi.yml")) + \
                 list(Path.cwd().glob("**/api*.yaml"))
    return candidates[0] if candidates else None

def find_prism_runner():
    """Detecta el mejor runner disponible para Prism sin requerir instalación global."""
    local_prism = Path.cwd() / "node_modules" / ".bin" / "prism"
    if local_prism.is_file() and os.access(local_prism, os.X_OK):
        return [str(local_prism)]
    if shutil.which("prism"):
        return ["prism"]
    if shutil.which("npx"):
        return ["npx", "--yes", "@stoplight/prism-cli@5"]
    return None

def find_hurl_runner():
    """Detecta hurl en PATH o en ~/.local/bin/hurl."""
    if shutil.which("hurl"):
        return "hurl"
    user_hurl = Path.home() / ".local/bin/hurl"
    if user_hurl.is_file() and os.access(user_hurl, os.X_OK):
        return str(user_hurl)
    return None

def run_native_python_mock(spec_path, port=PRISM_PORT):
    """Mock server nativo HTTP con la biblioteca estándar de Python sin requerir Node ni Prism."""
    import http.server
    import socketserver
    import re

    print(f"{YELLOW}⚠️  Prism no disponible. Iniciando Servidor Mock Nativo en Python (Zero-Dependency)...{NC}")
    print(f"{GREEN}✓ Servidor simulado activo en:{NC} {BOLD}http://localhost:{port}{NC}")
    print(f"{YELLOW}Presioná Ctrl+C para detener el mock.{NC}\n")

    # Parsear endpoints y respuestas de openapi.yaml
    endpoints = {}
    try:
        content = spec_path.read_text(encoding="utf-8")
        current_path = None
        current_method = None
        for line in content.splitlines():
            line_str = line.strip()
            if line_str.startswith("/") and line_str.endswith(":"):
                current_path = line_str[:-1]
                endpoints[current_path] = {}
            elif current_path and line_str in ["get:", "post:", "put:", "delete:", "patch:"]:
                current_method = line_str[:-1].upper()
                endpoints[current_path][current_method] = {"status": 200, "body": {"status": "ok", "mock": "python-native"}}
    except Exception as e:
        print(f"{YELLOW}Nota: parsing básico de OpenAPI: {e}{NC}")

    class MockHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            self._handle_request("GET")

        def do_POST(self):
            self._handle_request("POST")

        def do_PUT(self):
            self._handle_request("PUT")

        def do_DELETE(self):
            self._handle_request("DELETE")

        def _handle_request(self, method):
            parsed_path = self.path.split("?")[0]
            matched = endpoints.get(parsed_path, {}).get(method)
            
            # Response por defecto si no matchea exacto
            status = 200
            if parsed_path in ["/health", "/api/health"]:
                body = {"status": "healthy", "service": "chelo-harness-mock"}
            elif method == "POST":
                status = 201
                body = {"status": "created", "mock": True, "path": parsed_path}
            elif matched:
                status = matched["status"]
                body = matched["body"]
            else:
                body = {"message": f"Chelo Mock: {method} {parsed_path}", "status": "ok"}

            payload = json.dumps(body, indent=2).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("x-mock-engine", "chelo-python-native")
            self.end_headers()
            self.wfile.write(payload)

        def log_message(self, format, *args):
            print(f"   {CYAN}[Mock HTTP]{NC} {self.command} {self.path} -> 200/201")

    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", port), MockHandler) as httpd:
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print(f"\n{YELLOW}Servidor Mock detenido.{NC}")

def cmd_mock():
    banner()
    spec = find_openapi_spec()
    if not spec:
        print(f"{RED}❌ No se encontró archivo de especificación OpenAPI (*.yaml) en el repositorio.{NC}")
        print(f"{YELLOW}Tip: Ejecutá 'chelo-harness init' para crear tu openapi.yaml base.{NC}")
        sys.exit(1)

    runner = find_prism_runner()
    if runner:
        print(f"{BLUE}🚀 Levantando Prism Mock Server desde:{NC} {spec}")
        print(f"{GREEN}✓ Servidor simulado activo en:{NC} {BOLD}http://localhost:{PRISM_PORT}{NC}")
        print(f"{YELLOW}Presioná Ctrl+C para detener el mock.{NC}\n")
        cmd = runner + ["mock", str(spec), "-p", str(PRISM_PORT), "-m"]
        subprocess.run(cmd)
    else:
        run_native_python_mock(spec, PRISM_PORT)

def cmd_proxy(backend_url=f"http://localhost:{BACKEND_PORT}"):
    banner()
    spec = find_openapi_spec()
    if not spec:
        print(f"{RED}❌ No se encontró archivo OpenAPI (*.yaml) para validar el proxy.{NC}")
        sys.exit(1)

    runner = find_prism_runner()
    if runner:
        print(f"{BLUE}🛡️ Levantando Prism Proxy de Validación:{NC}")
        print(f"   • Contrato: {spec}")
        print(f"   • Backend Real: {backend_url}")
        print(f"   • Proxy Validador: {BOLD}http://localhost:{PRISM_PORT}{NC}\n")
        cmd = runner + ["proxy", str(spec), backend_url, "-p", str(PRISM_PORT), "--validate-request"]
        subprocess.run(cmd)
    else:
        print(f"{RED}❌ Error: Prism Proxy requiere Prism CLI o npx para validar el tráfico.{NC}")
        print(f"{YELLOW}Instalá Prism como dependencia del proyecto: npm install --save-dev @stoplight/prism-cli{NC}")
        sys.exit(1)

def run_native_python_test(hurl_file):
    """Ejecutor HTTP mínimo de pruebas para archivos .hurl simples sin requerir el binario hurl."""
    import urllib.request
    import urllib.error
    
    try:
        content = hurl_file.read_text(encoding="utf-8")
        lines = [l.strip() for l in content.splitlines() if l.strip() and not l.strip().startswith("#")]
        if not lines:
            return True
            
        first_line = lines[0].split()
        method = first_line[0]
        url = first_line[1]
        
        req = urllib.request.Request(url, method=method)
        req.add_header("User-Agent", "CheloHarness-NativeTest/1.0")
        
        try:
            with urllib.request.urlopen(req, timeout=5) as response:
                status_code = response.getcode()
        except urllib.error.HTTPError as e:
            status_code = e.code

        # Chequear si espera HTTP 200, 201, etc.
        expected_status = 200
        for l in lines:
            if l.startswith("HTTP"):
                parts = l.split()
                if len(parts) >= 2 and parts[1].isdigit():
                    expected_status = int(parts[1])
                    break
                    
        return status_code == expected_status
    except Exception as e:
        return False

def cmd_test():
    banner()
    hurl_files = sorted(list(Path.cwd().glob("**/*.hurl")))
    if not hurl_files:
        print(f"{YELLOW}⚠️  No se encontraron archivos de test .hurl en el repositorio.{NC}")
        return False

    hurl_bin = find_hurl_runner()
    print(f"{BLUE}▶ Ejecutando {len(hurl_files)} pruebas de contrato {'(con binario Hurl)' if hurl_bin else '(runner nativo Python)'}...{NC}\n")
    failed = 0
    for hf in hurl_files:
        print(f"   🧪 Testeando {hf.name}...", end=" ", flush=True)
        if hurl_bin:
            res = subprocess.run([hurl_bin, "--test", str(hf)], capture_output=True, text=True)
            passed = (res.returncode == 0)
            err = res.stderr.strip()[:300] if res.stderr else ""
        else:
            passed = run_native_python_test(hf)
            err = "El status code no coincidió con el esperado."

        if passed:
            print(f"{GREEN}PASÓ ✓{NC}")
        else:
            print(f"{RED}FALLÓ ✗{NC}")
            failed += 1
            if err:
                print(f"{YELLOW}{err}{NC}")

    if failed == 0:
        print(f"\n{GREEN}{BOLD}✓ TODAS LAS PRUEBAS SUPERADAS SIN VIOLACIONES DE CONTRATO.{NC}\n")
        return True
    else:
        print(f"\n{RED}{BOLD}❌ {failed} prueba(s) fallaron contra el contrato OpenAPI.{NC}\n")
        return False

def cmd_interactive_session():
    banner()
    check_git_repo()
    project = get_project_name()

    print(f"📂 Proyecto detectado: {BOLD}{GREEN}{project}{NC}\n")

    cmd_daily_sync()

    # FASE 0: INVESTIGACIÓN Y REQUERIMIENTOS
    print(f"{MAGENTA}{BOLD}📋 FASE 0: INVESTIGACIÓN & LEVANTAMIENTO DE REQUERIMIENTOS{NC}")
    print(f"{YELLOW}Antes del código y la arquitectura técnica, definimos el problema de negocio.{NC}\n")

    selected_issue_number = None
    if shutil.which("gh"):
        try:
            sprint_info = chelo_channels.get_github_sprint_context()
            open_issues = sprint_info.get("issues", [])
            if open_issues:
                issue_opts = [f"#{i['number']} {i['title']}" for i in open_issues[:5]]
                usar_gh = select_option("¿Querés asociar esta sesión a un Issue abierto de GitHub?", ["Escribir requerimiento manual"] + issue_opts, allow_custom=False)
                if usar_gh != "Escribir requerimiento manual":
                    selected_issue_number = usar_gh.split()[0].replace("#", "")
                    subprocess.run(["gh", "issue", "edit", selected_issue_number, "--add-label", "status:in-progress", "--remove-label", "status:todo"], capture_output=True)
                    print(f"   {GREEN}✓ Issue #{selected_issue_number} vinculado y marcado `status:in-progress` en GitHub.{NC}\n")
        except Exception:
            pass

    req_problema = prompt_text("1. ¿Qué problema o ineficiencia del proceso actual se quiere resolver?", "Gestión manual lenta y propensa a errores")
    print(f"   {GREEN}✓ Problema:{NC} {req_problema}\n")

    req_actores = prompt_text("2. ¿Quiénes son los actores que interactúan con el sistema? (ej: Administrador, Cliente, API)", "Administrador, Sistema API")
    print(f"   {GREEN}✓ Actores:{NC} {req_actores}\n")

    req_alcance = prompt_text("3. ¿Cuál es el alcance funcional concreto (Qué debe hacer y qué NO debe hacer)?", "CRUD de la entidad principal sin dependencias complejas")
    print(f"   {GREEN}✓ Alcance:{NC} {req_alcance}\n")

    req_criterio = prompt_text("4. ¿Cuál es el criterio de aceptación / escenario BDD clave? (Given / When / Then)", "Dado un payload válido, cuando se envíe un POST, responde 201 y el recurso creado")
    print(f"   {GREEN}✓ Criterio de Aceptación:{NC} {req_criterio}\n")

    # FASE 1: ENCUADRE TÉCNICO
    print(f"{BLUE}{BOLD}🧠 FASE 1: ENCUADRE DE ARQUITECTURA & GOBERNANZA TÉCNICA{NC}\n")

    tipos_tarea = [
        "Nueva Feature / Requerimiento (OpenAPI Spec -> Hurl Test -> Mock -> Code)",
        "Refactorización / Clean Code (Preservar contrato OpenAPI intacto)",
        "Bugfix / Corrección (Reproducir primero con test .hurl fallido)",
        "Infraestructura / Docker / Despliegue (Dockerfile, compose, networking)",
        "Testing / Cobertura de Contrato (Batería Hurl y asserts sl-violations)"
    ]
    p_tipo = select_option("¿Qué tipo de trabajo técnico estás encarando?", tipos_tarea)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_tipo}\n")

    patrones_arq = [
        "Spec-First / Contract-Driven (OpenAPI + Prism Mock + Hurl Tests sin BBDD inicial)",
        "Hexagonal / Ports & Adapters (Dominio desacoplado de infraestructura)",
        "Clean Architecture / Onion (Casos de uso y entidades puras)",
        "Container / Presentational (UI tonta desacoplada de API)",
        "Unix-First / CLI Pipeline (Herramientas nativas ligeras sin dependencias infladas)"
    ]
    p_arquitectura = select_option("¿Bajo qué patrón de arquitectura se debe desarrollar?", patrones_arq)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_arquitectura}\n")

    disciplinas_spec = [
        "Ciclo Completo: Documentación (Actores/Alcance/Gherkin) + OpenAPI + Prism Mock (:4010) + Hurl Tests",
        "API-First Estricto: Contrato OpenAPI (.yaml) + Prism Mock + Tests Hurl sin violaciones ('sl-violations')",
        "TDD Backend: Endpoint en PHP/Node validado vía Prism Proxy antes de persistir",
        "Docs-as-Code: Diagramas Mermaid (.mmd) integrados en Markdown"
    ]
    p_spec = select_option("¿Qué protocolo de verificación debe anteponerse al código?", disciplinas_spec)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_spec}\n")

    lenguajes = [
        "PHP nativo modular / SQLite (Router declarativo, PDO, cero frameworks inflados)",
        "TypeScript / Node.js (Prism, Fastify, Express o React nativo)",
        "Python (FastAPI / Typer)",
        "Bash / Shell Scripting (Unix tools, curl, hurl, jq)"
    ]
    p_lenguaje = select_option("¿Cuál es el stack / runtime base?", lenguajes)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_lenguaje}\n")

    restricciones = [
        "REGLA DE CONTRATO: El test Hurl debe validar que no exista el header 'sl-violations'",
        "REGLA DE TDD: Ningún endpoint en backend sin su test .hurl correspondiente",
        "REGLA DE SIMPLICIDAD: Cero bases de datos pesadas en fase de diseño; resolver primero con mock/sqlite",
        "REGLA DE CONTENEDOR: El proyecto debe levantarse de forma reproducible sin paquetes globales",
        "REGLA DE CONFINAMIENTO: Modificar únicamente los archivos asociados al ticket (máx 10)"
    ]
    p_restriccion = select_option("¿Cuál es la restricción crítica que el agente NO puede violar?", restricciones)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_restriccion}\n")

    # SELECCIÓN INTELIGENTE DE AGENTE
    has_opencode = bool(shutil.which("opencode"))
    has_agy = bool(shutil.which("agy"))

    agentes = []
    if has_opencode:
        agentes.append("OpenCode CLI (Ejecución directa en segundo plano / terminal)")
        agentes.append("OpenCode TUI (Sesión interactiva en multiplexer Herdr)")
    else:
        agentes.append("Instalar OpenCode ahora (curl -fsSL https://opencode.ai/install | bash)")

    if has_agy:
        agentes.append("Antigravity CLI (Copiar prompt blindado al portapapeles para AGY)")
    else:
        agentes.append("Copiar prompt al portapapeles (Para usar con Claude / Cursor / ChatGPT)")

    agentes.append("Solo registrar contexto en Engram (no disparar agente ahora)")

    p_agente = select_option("¿Qué agente ejecutará este trabajo?", agentes, allow_custom=False)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_agente}\n")

    # Persistir en Engram
    topic = f"harness/{project}/{p_tipo.split('/')[0].strip().lower().replace(' ', '-')}"
    doc_content = (
