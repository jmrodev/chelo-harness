        f"- **Criterio de Aceptación (BDD)**: {req_criterio}\n"
        f"- **GitHub Issue**: {f'#{selected_issue_number}' if selected_issue_number else 'N/A'}\n\n"
        f"## 2. Encuadre Técnico (Fase 1)\n"
        f"- **Tipo de Tarea**: {p_tipo}\n"
        f"- **Patrón Arquitectónico**: {p_arquitectura}\n"
        f"- **Protocolo Contract-First**: {p_spec}\n"
        f"- **Stack**: {p_lenguaje}\n"
        f"- **Restricción Crítica**: {p_restriccion}\n"
    )

    try:
        if shutil.which("engram"):
            p = subprocess.Popen(["engram", "set", topic], stdin=subprocess.PIPE, text=True)
            p.communicate(input=doc_content)
            print(f"{GREEN}✓ Memoria persistida en Engram:{NC} `{topic}`\n")
    except Exception:
        pass

    prompt_confinado = (
        f"ANÁLISIS DE NEGOCIO (REQUERIMIENTOS):\n"
        f"  • PROBLEMA: {req_problema}\n"
        f"  • ACTORES: {req_actores}\n"
        f"  • ALCANCE: {req_alcance}\n"
        f"  • BDD / CRITERIO: {req_criterio}\n"
        f"{f'  • TICKET GITHUB: Closes #{selected_issue_number}' if selected_issue_number else ''}\n\n"
        f"ARQUITECTURA: {p_arquitectura}\n"
        f"STACK: {p_lenguaje}\n\n"
        f"PROTOCOLO STRICT SPEC-FIRST:\n"
        f"  1. DOCUMENTACIÓN & MODELADO: Definir casos de negocio en markdown y diagramas Mermaid (.mmd).\n"
        f"  2. CONTRATO SAGRADO: Escribir/actualizar openapi.yaml con schemas, rutas y examples.\n"
        f"  3. PRISM MOCK: El endpoint debe responder en http://localhost:4010 simulado por Prism sin BBDD.\n"
        f"  4. TEST HURL: Escribir test (.hurl) con assert `header 'sl-violations' not exists`.\n"
        f"  5. BACKEND TARDÍO: Implementar la ruta mínima en PHP/Node y SQLite solo cuando el mock pase.\n\n"
        f"REGLA CRÍTICA: {p_restriccion}\n"
        f"LÍMITE ESTRICTO: No modificar más de 10 archivos bajo ninguna circunstancia."
    )

    if "Instalar OpenCode" in p_agente:
        print(f"\n{BLUE}🚀 Instalando OpenCode CLI oficial...{NC}")
        subprocess.run("curl -fsSL https://opencode.ai/install | bash", shell=True)
        print(f"{GREEN}✓ OpenCode instalado.{NC} Volvé a correr chelo-harness para ejecutarlo.")

    elif "OpenCode CLI" in p_agente:
        print(f"\n{BLUE}🚀 Disparando OpenCode con el prompt gobernado...{NC}\n")
        subprocess.run(["opencode", "run", prompt_confinado])
        audit_changes_rule()

    elif "OpenCode TUI" in p_agente:
        print(f"\n{BLUE}🚀 Abriendo OpenCode TUI en el workspace...{NC}")
        if shutil.which("wl-copy"):
            subprocess.run(f"printf '%s' \"{prompt_confinado}\" | wl-copy", shell=True)
            print(f"{GREEN}✓ Prompt gobernado copiado al portapapeles.{NC} Pegalo con Ctrl+V.")
        subprocess.run(["opencode"])
        audit_changes_rule()

    elif "portapapeles" in p_agente.lower() or "antigravity" in p_agente.lower():
        if shutil.which("wl-copy"):
            subprocess.run(f"printf '%s' \"{prompt_confinado}\" | wl-copy", shell=True)
            print(f"\n{GREEN}{BOLD}✓ Prompt gobernado generado y copiado al portapapeles.{NC}")
        else:
            print(f"\n{GREEN}{BOLD}✓ Prompt gobernado generado:{NC}")

        print(f"{CYAN}Pegalo en tu chat con Antigravity, Claude, ChatGPT o Cursor.{NC}\n")
        print(f"{BOLD}Contenido del marco:{NC}")
        print(f"--------------------------------------------------")
        print(prompt_confinado)
        print(f"--------------------------------------------------")

def cmd_gate():
    banner()
    check_git_repo()
    print(f"{BLUE}Iniciando Quality Gate en:{NC} {Path.cwd()}\n")

    if not audit_changes_rule():
        sys.exit(2)

    cmd_test()

    if shutil.which("gga"):
        print(f"\n{BLUE}▶ Ejecutando auditoría de riesgos con GGA...{NC}")
        gga_res = subprocess.run(["gga", "review", "--staged"], capture_output=True, text=True)
        if gga_res.returncode == 0:
            print(f"{GREEN}✓ Auditoría GGA aprobada sin riesgos críticos.{NC}")
        else:
            print(f"{YELLOW}⚠️  Aviso GGA:{NC}\n{gga_res.stdout[:300]}")

    print(f"\n{GREEN}{BOLD}✓ QUALITY GATE SUPERADO EXITOSAMENTE.{NC}")

def cmd_commit(message):
    banner()
    check_git_repo()

    if not audit_changes_rule():
        sys.exit(2)

    if "Co-Authored-By" in message or "AI" in message:
        print(f"{RED}❌ Error de gobernanza: Prohibido incluir atribución de IA o Co-Authored-By en el commit.{NC}")
        sys.exit(1)

    print(f"▶ Commiteando cambios con mensaje convencional: {BOLD}{message}{NC}")
    subprocess.run(["git", "add", "."])
    res = subprocess.run(["git", "commit", "-m", message])
    if res.returncode == 0:
        print(f"{GREEN}✓ Commit exitoso.{NC}")

def cmd_update():
    banner()
    print(f"{BLUE}🔄 ACTUALIZACIÓN DE CHELO-HARNESS{NC}\n")
    print("Actualizando chelo-harness a la última versión...")
    res = subprocess.run("curl -fsSL https://raw.githubusercontent.com/jmrodev/chelo-harness/main/install.sh | bash", shell=True)
    if res.returncode == 0:
        print(f"\n{GREEN}{BOLD}✓ CHELO-HARNESS ACTUALIZADO AL DÍA.{NC}")
    else:
        print(f"\n{RED}❌ Error durante la actualización.{NC}")

def print_help():
    banner()
    print("COMANDOS DISPONIBLES:")
    print("  chelo-harness                   Inicia sesión ágil guiada (Requerimientos -> Contrato -> Agente)")
    print("  chelo-harness init              Inicializa un proyecto nuevo (git, docs/, tests/, openapi.yaml)")
    print("  chelo-harness setup             Asistente universal de claves (Gemini API Key para OpenCode)")
    print("  chelo-harness doctor            Diagnóstico de herramientas (gh, prism, hurl, opencode, keys)")
    print("  chelo-harness update            Actualiza chelo-harness y todas sus herramientas al día")
    print("  chelo-harness sync              Sincronización Daily Scrum (Slack #practicas + Milestones GitHub)")
    print("  chelo-harness board [open|init] Abre el Daily Board o inyecta su GitHub Pages con one-liner")
    print("  chelo-harness mock              Levanta Prism Mock Server (:4010) leyendo el openapi.yaml")
    print("  chelo-harness proxy [url]       Levanta Prism Proxy validador contra backend real (:8000)")
    print("  chelo-harness test              Ejecuta la suite de pruebas Hurl (*.hurl) contra el contrato")
    print("  chelo-harness gate              Ejecuta Quality Gate completo (10 cambios, Hurl, GGA)")
    print("  chelo-harness commit \"<msg>\"    Commitea con validaciones de gobernanza pre-commit")
    print("  chelo-harness status            Inspecciona el estado del workspace bajo las reglas de Chelo")

def main():
    if len(sys.argv) == 1:
        cmd_interactive_session()
        sys.exit(0)

    cmd = sys.argv[1]
    if cmd in ["ask", "learn", "start", "run", "menu"]:
        cmd_interactive_session()
    elif cmd == "init":
        cmd_init()
    elif cmd in ["setup", "config", "keys"]:
        cmd_setup()
    elif cmd in ["doctor", "check"]:
        cmd_doctor()
    elif cmd in ["update", "upgrade"]:
        cmd_update()
    elif cmd in ["sync", "daily", "novedades"]:
        cmd_daily_sync()
    elif cmd == "board":
        sub = sys.argv[2] if len(sys.argv) > 2 else "open"
        cmd_board(sub)
    elif cmd == "mock":
        cmd_mock()
    elif cmd == "proxy":
        backend = sys.argv[2] if len(sys.argv) > 2 else f"http://localhost:{BACKEND_PORT}"
        cmd_proxy(backend)
    elif cmd == "test":
        cmd_test()
    elif cmd == "gate":
        cmd_gate()
    elif cmd == "commit":
        if len(sys.argv) < 3:
            print(f"{RED}Falta el mensaje de commit. Uso: chelo-harness commit \"tipo(scope): mensaje\"{NC}")
            sys.exit(1)
        cmd_commit(sys.argv[2])
    elif cmd == "status":
        banner()
        check_git_repo()
        audit_changes_rule()
    else:
        print_help()

if __name__ == "__main__":
    main()
