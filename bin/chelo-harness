def cmd_board(action="open"):
    banner()
    if action == "init":
        print(f"{BLUE}🚀 Instalando Daily Board en este repositorio...{NC}")
        subprocess.run("curl -sL https://raw.githubusercontent.com/jmrodev/daily-board/main/install.sh | bash", shell=True)
    else:
        try:
            repo_url = subprocess.run(["gh", "repo", "view", "--json", "url", "-q", ".url"], capture_output=True, text=True).stdout.strip()
            if repo_url:
                org_repo = repo_url.replace("https://github.com/", "")
                org, repo = org_repo.split("/")
                board_url = f"https://{org}.github.io/{repo}/"
                print(f"{GREEN}✓ Abriendo Daily Board:{NC} {board_url}")
                subprocess.run(["xdg-open", board_url], capture_output=True)
            else:
                subprocess.run(["xdg-open", "https://jmrodev.github.io/daily-board/"], capture_output=True)
        except Exception:
            print(f"{YELLOW}No se pudo detectar URL de GitHub Pages. Abriendo repo de Daily Board...{NC}")
            subprocess.run(["xdg-open", "https://github.com/jmrodev/daily-board"], capture_output=True)

def find_openapi_spec():
    candidates = list(Path.cwd().glob("**/openapi.yaml")) + \
                 list(Path.cwd().glob("**/openapi.yml")) + \
                 list(Path.cwd().glob("**/api*.yaml"))
    return candidates[0] if candidates else None

def find_prism_runner():
    """Detecta el mejor runner disponible para Prism sin requerir instalación global."""
    local_prism = Path.cwd() / "node_modules" / ".bin" / "prism"
    if local_prism.is_file() and os.access(local_prism, os.X_OK):
        return [str(local_prism)]
    if shutil.which("prism"):
        return ["prism"]
    if shutil.which("npx"):
        return ["npx", "--yes", "@stoplight/prism-cli@5"]
    return None

def find_hurl_runner():
    """Detecta hurl en PATH o en ~/.local/bin/hurl."""
    if shutil.which("hurl"):
        return "hurl"
    user_hurl = Path.home() / ".local/bin/hurl"
    if user_hurl.is_file() and os.access(user_hurl, os.X_OK):
        return str(user_hurl)
    return None

def run_native_python_mock(spec_path, port=PRISM_PORT):
    """Mock server nativo HTTP con la biblioteca estándar de Python sin requerir Node ni Prism."""
    import http.server
    import socketserver
    import re

    print(f"{YELLOW}⚠️  Prism no disponible. Iniciando Servidor Mock Nativo en Python (Zero-Dependency)...{NC}")
    print(f"{GREEN}✓ Servidor simulado activo en:{NC} {BOLD}http://localhost:{port}{NC}")
    print(f"{YELLOW}Presioná Ctrl+C para detener el mock.{NC}\n")

    # Parsear endpoints y respuestas de openapi.yaml
    endpoints = {}
    try:
        content = spec_path.read_text(encoding="utf-8")
        current_path = None
        current_method = None
        for line in content.splitlines():
            line_str = line.strip()
            if line_str.startswith("/") and line_str.endswith(":"):
                current_path = line_str[:-1]
                endpoints[current_path] = {}
            elif current_path and line_str in ["get:", "post:", "put:", "delete:", "patch:"]:
                current_method = line_str[:-1].upper()
                endpoints[current_path][current_method] = {"status": 200, "body": {"status": "ok", "mock": "python-native"}}
    except Exception as e:
        print(f"{YELLOW}Nota: parsing básico de OpenAPI: {e}{NC}")

    class MockHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            self._handle_request("GET")

        def do_POST(self):
            self._handle_request("POST")

        def do_PUT(self):
            self._handle_request("PUT")

        def do_DELETE(self):
            self._handle_request("DELETE")

        def _handle_request(self, method):
            parsed_path = self.path.split("?")[0]
            matched = endpoints.get(parsed_path, {}).get(method)
            
            # Response por defecto si no matchea exacto
            status = 200
            if parsed_path in ["/health", "/api/health"]:
                body = {"status": "healthy", "service": "chelo-harness-mock"}
            elif method == "POST":
                status = 201
                body = {"status": "created", "mock": True, "path": parsed_path}
            elif matched:
                status = matched["status"]
                body = matched["body"]
            else:
                body = {"message": f"Chelo Mock: {method} {parsed_path}", "status": "ok"}

            payload = json.dumps(body, indent=2).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("x-mock-engine", "chelo-python-native")
            self.end_headers()
            self.wfile.write(payload)

        def log_message(self, format, *args):
            print(f"   {CYAN}[Mock HTTP]{NC} {self.command} {self.path} -> 200/201")

    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", port), MockHandler) as httpd:
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print(f"\n{YELLOW}Servidor Mock detenido.{NC}")

def cmd_mock():
    banner()
    spec = find_openapi_spec()
    if not spec:
        print(f"{RED}❌ No se encontró archivo de especificación OpenAPI (*.yaml) en el repositorio.{NC}")
        print(f"{YELLOW}Tip: Ejecutá 'chelo-harness init' para crear tu openapi.yaml base.{NC}")
        sys.exit(1)

    runner = find_prism_runner()
    if runner:
        print(f"{BLUE}🚀 Levantando Prism Mock Server desde:{NC} {spec}")
        print(f"{GREEN}✓ Servidor simulado activo en:{NC} {BOLD}http://localhost:{PRISM_PORT}{NC}")
        print(f"{YELLOW}Presioná Ctrl+C para detener el mock.{NC}\n")
        cmd = runner + ["mock", str(spec), "-p", str(PRISM_PORT)]
        subprocess.run(cmd)
    else:
        run_native_python_mock(spec, PRISM_PORT)

def cmd_proxy(backend_url=f"http://localhost:{BACKEND_PORT}"):
    banner()
    spec = find_openapi_spec()
    if not spec:
        print(f"{RED}❌ No se encontró archivo OpenAPI (*.yaml) para validar el proxy.{NC}")
        sys.exit(1)

    runner = find_prism_runner()
    if runner:
        print(f"{BLUE}🛡️ Levantando Prism Proxy de Validación:{NC}")
        print(f"   • Contrato: {spec}")
        print(f"   • Backend Real: {backend_url}")
        print(f"   • Proxy Validador: {BOLD}http://localhost:{PRISM_PORT}{NC}\n")
        cmd = runner + ["proxy", str(spec), backend_url, "-p", str(PRISM_PORT), "--validate-request"]
        subprocess.run(cmd)
    else:
        print(f"{RED}❌ Error: Prism Proxy requiere Prism CLI o npx para validar el tráfico.{NC}")
        print(f"{YELLOW}Instalá Prism como dependencia del proyecto: npm install --save-dev @stoplight/prism-cli{NC}")
        sys.exit(1)

def run_native_python_test(hurl_file):
    """Ejecutor HTTP mínimo de pruebas para archivos .hurl simples sin requerir el binario hurl."""
    import urllib.request
    import urllib.error
    
    try:
        content = hurl_file.read_text(encoding="utf-8")
        lines = [l.strip() for l in content.splitlines() if l.strip() and not l.strip().startswith("#")]
        if not lines:
            return True
            
        first_line = lines[0].split()
        method = first_line[0]
        url = first_line[1]
        
        req = urllib.request.Request(url, method=method)
        req.add_header("User-Agent", "CheloHarness-NativeTest/1.0")
        
        try:
            with urllib.request.urlopen(req, timeout=5) as response:
                status_code = response.getcode()
        except urllib.error.HTTPError as e:
            status_code = e.code

        # Chequear si espera HTTP 200, 201, etc.
        expected_status = 200
        for l in lines:
            if l.startswith("HTTP"):
                parts = l.split()
                if len(parts) >= 2 and parts[1].isdigit():
                    expected_status = int(parts[1])
                    break
                    
        return status_code == expected_status
    except Exception as e:
        return False

def execute_tests_and_collect_errors():
    """Ejecuta los tests y devuelve (passed, lista_errores)."""
    hurl_files = sorted(list(Path.cwd().glob("**/*.hurl")))
    if not hurl_files:
        return False, ["No se encontraron archivos de test .hurl en el repositorio."]

    hurl_bin = find_hurl_runner()
    failed = 0
    errors = []

    for hf in hurl_files:
        print(f"   🧪 Testeando {hf.name}...", end=" ", flush=True)
        if hurl_bin:
            res = subprocess.run([hurl_bin, "--test", str(hf)], capture_output=True, text=True)
            passed = (res.returncode == 0)
            raw_err = (res.stderr or "").strip()
            filtered_lines = [
                line for line in raw_err.splitlines()
                if "no version information available" not in line
            ]
            err = "\n".join(filtered_lines).strip()
        else:
            passed = run_native_python_test(hf)
            err = "El status code o payload no coincidió con lo esperado."

        if passed:
            print(f"{GREEN}PASÓ ✓{NC}")
        else:
            print(f"{RED}FALLÓ ✗{NC}")
            failed += 1
            if err:
                print(f"{YELLOW}{err[:300]}{NC}")
                errors.append(f"Archivo: {hf.name}\nDetalle:\n{err}")

    if failed == 0:
        print(f"\n{GREEN}{BOLD}✓ TODAS LAS PRUEBAS SUPERADAS SIN VIOLACIONES DE CONTRATO.{NC}\n")
        return True, []
    else:
        print(f"\n{RED}{BOLD}❌ {failed} prueba(s) fallaron contra el contrato OpenAPI.{NC}\n")
        return False, errors

def cmd_test():
    banner()
    passed, _ = execute_tests_and_collect_errors()
    return passed

def select_view_mode():
    """Permite al desarrollador elegir de forma agnóstica cómo visualizar y controlar el workflow."""
    if "--zen" in sys.argv or "-q" in sys.argv:
        return "zen"
    if "--chusma" in sys.argv or "--verbose" in sys.argv or "-v" in sys.argv:
        return "chusma"
    if "--control" in sys.argv or "--diff" in sys.argv or "-c" in sys.argv:
        return "control"
    if "--dashboard" in sys.argv or "-d" in sys.argv:
        return "dashboard"

    print(f"{BOLD}{CYAN}¿Qué nivel de visibilidad y control querés sobre el workflow?{NC}")
    print(f"  [1] 🧘 {BOLD}Modo Zen (Piloto Automático){NC}: Cero ruido. Que suceda todo y avise al final.")
    print(f"  [2] 👀 {BOLD}Modo Chusma (Streaming en Vivo){NC}: Ver en tiempo real qué piensa y escribe cada agente.")
    print(f"  [3] 🔍 {BOLD}Modo Control Total (Diff & Approval){NC}: Pausa en cada cambio, muestra git diff y pide tu OK.")
    print(f"  [4] 🎛️  {BOLD}Modo Dashboard TUI (Multi-panel ANSI){NC}: Monitor visual en cajas Curses en tu terminal.")
    
    choice = input(f"\n{BOLD}Seleccioná [1-4] (Default: 1): {NC}").strip()
    if choice == "2":
        return "chusma"
    elif choice == "3":
        return "control"
    elif choice == "4":
        return "dashboard"
    return "zen"

